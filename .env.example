# backend/app/core/config.py が読み込む環境変数（すべて SASAGE_ prefix）
# コピーして .env として backend/ 直下 もしくはリポジトリルートに置く

# 背景除去バックエンド: rembg | grabcut
SASAGE_BACKGROUND_REMOVAL_BACKEND=rembg

# 状態検品バックエンド: heuristic | llm_vision
SASAGE_CONDITION_BACKEND=heuristic

# 原稿生成バックエンド: template_fallback | claude
SASAGE_LLM_BACKEND=template_fallback

# Claude (Anthropic API) を使う場合のみ設定
SASAGE_ANTHROPIC_API_KEY=
SASAGE_ANTHROPIC_MODEL=claude-sonnet-5

# Streamlit UIからバックエンドAPIを呼ぶ際のURL
SASAGE_API_BASE_URL=http://localhost:8000
